# Supabase Configuration (from Supabase Dashboard > Project Settings > API)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Backend API URL
# Leave empty or omit if running fullstack on Vercel with rewrites.
# For local development with Python Flask server:
# REACT_APP_API_URL=http://127.0.0.1:8000
# For production if Python backend is hosted separately (e.g. on Render / Railway):
# REACT_APP_API_URL=https://your-backend.onrender.com

# Optional Google OAuth Client ID
# REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
